        <mxCell id="VU9aSVveH0iyHMuGNZEg-59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#fad9d5;strokeColor=#ae4132;" value="Come si calcola la capacità di un condensatore?" vertex="1">
          <mxGeometry height="60" width="120" x="10" y="990" as="geometry" />
        </mxCell>
        <mxCell id="VU9aSVveH0iyHMuGNZEg-60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#fad7ac;strokeColor=#b46504;" value="&lt;div&gt;C = Q/V [F]&lt;/div&gt;&lt;div&gt;1F = 1C/1V&lt;br&gt;&lt;br&gt;Q=Carica accumulata&lt;br&gt;V=Tensione&lt;/div&gt;" vertex="1">
