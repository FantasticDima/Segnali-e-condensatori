        </mxCell>
        <mxCell id="VU9aSVveH0iyHMuGNZEg-63" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;rounded=1;roundedPerimeter=1;arcSize=13;imageBorder=default;" value="" vertex="1">
