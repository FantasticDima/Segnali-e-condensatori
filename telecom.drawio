        </mxCell>
        <mxCell id="VU9aSVveH0iyHMuGNZEg-64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="In questo schema, l&#39;interruttore è aperto quindi il condensatore non riceve tensione ai suoi capi e quindi è scarico" vertex="1">
          <mxGeometry height="60" width="240" x="370" y="830" as="geometry" />
        </mxCell>
        <mxCell id="VU9aSVveH0iyHMuGNZEg-65" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;rounded=1;roundedPerimeter=1;arcSize=14;imageBorder=default;" value="" vertex="1">
          <mxGeometry height="185" width="271.21" x="360" y="1175" as="geometry" />
        </mxCell>
        <mxCell id="VU9aSVveH0iyHMuGNZEg-66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="In questo schema, l&#39;interruttore è chiuso quindi il condensatore si carica. Vuol dire che le cariche positive accumulate sulla piastra superiore attirano le cariche negative alla piastra inferiore, tutto questo senza chiudere il circuito, quindi crea tensione tra le due piastre" vertex="1">
          <mxGeometry height="60" width="422.07" x="367.93" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="VU9aSVveH0iyHMuGNZEg-67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="La tensione ai capi della resistenza è R * i(t)" vertex="1">
          <mxGeometry height="60" width="148.97" x="360" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="VU9aSVveH0iyHMuGNZEg-68" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="La tensione ai capi del condensatore nel tempo è Vc&lt;br&gt;&lt;div&gt;Vc = E.elevato(-t/R*C)&lt;/div&gt;&lt;div&gt;Dove E = R * i(t) + Vc&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="148.97" x="520" y="1370" as="geometry" />
        </mxCell>
